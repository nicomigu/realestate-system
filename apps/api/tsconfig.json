{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true
  },
  // migrations/ is rendered by Prisma and imports JSON snapshots without the
  // `with { type: 'json' }` shape nodenext expects; it runs via `node`, not tsc.
  // prisma.config.ts is read by the Prisma CLI, and its inferred type can't be
  // named under `declaration: true`.
  "exclude": ["node_modules", "dist", "migrations", "prisma.config.ts"]
}
