# Copy this file to `.env`. Values match the services in docker-compose.yml.
# Requires PostgreSQL >= 15.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL="postgresql://realestate:realestate@localhost:5432/realestate"
REDIS_URL="redis://localhost:6379/0"
WEB_ORIGIN="http://localhost:3001"
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHAT_TOKEN_SECRET="replace-with-a-random-secret-of-32-plus-characters"
PUBLIC_RATE_LIMIT_PER_MINUTE=5
